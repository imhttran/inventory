# Copy to .env (personal values win over .env.dev — see backend/src/config.rs).
# Everything here has a code default; only set what you need to change.

# Backend
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inventory?sslmode=disable
PORT=8080
NODE_ENV=development
JWT_SECRET=change-me-in-production
FRONTEND_URL=http://localhost:3000

# Mail (unset SMTP_HOST = emails are logged, not sent — fine for dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com

# Auth behavior
MAX_ATTEMPTS=3
# EMAIL_VERIFICATION_REQUIRED=false skips the verify-email gate in dev.
EMAIL_VERIFICATION_REQUIRED=true

# Search pipeline (empty ELASTICSEARCH_URL disables it; queries fall back to
# Postgres ILIKE)
ELASTICSEARCH_URL=http://localhost:9200
SEARCH_INDEX=products

# Frontend (only for a split-domain deployment; the default proxies /api/*)
# API_URL=http://localhost:8080
# NEXT_PUBLIC_API_URL=
